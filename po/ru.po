#: data/io.github.sachesi.spiral.desktop:2
#: data/io.github.sachesi.spiral.metainfo.xml:6
msgid "Spiral"
msgstr "Spiral"

#: data/io.github.sachesi.spiral.desktop:3
msgid "File Manager"
msgstr "Файловый менеджер"

#: data/io.github.sachesi.spiral.desktop:4
#: data/io.github.sachesi.spiral.metainfo.xml:7 src/application.rs:342
#, no-c-format
msgid "Browse and manage your files"
msgstr "Просмотр и управление файлами"

#: data/io.github.sachesi.spiral.desktop:12
msgid "folder;manager;explore;disk;filesystem;"
msgstr ""
"папка;файлы;менеджер;проводник;диск;файловая "
"система;folder;manager;explore;disk;filesystem;"

#: data/io.github.sachesi.spiral.gschema.xml:34
msgid "Unit system for file sizes"
msgstr "Единицы измерения размера файлов"

#: data/io.github.sachesi.spiral.gschema.xml:38
msgid "Clicks needed to open an item"
msgstr "Число щелчков для открытия объекта"

#: data/io.github.sachesi.spiral.gschema.xml:42
msgid "Sort folders before files"
msgstr "Показывать папки перед файлами"

#: data/io.github.sachesi.spiral.gschema.xml:46
msgid "How dates are shown"
msgstr "Формат отображения дат"

#: data/io.github.sachesi.spiral.gschema.xml:50
msgid "Show “Delete Permanently” in context menus"
msgstr "Показывать «Удалить безвозвратно» в контекстных меню"

#: data/io.github.sachesi.spiral.gschema.xml:54
msgid "Show “Create Link” in context menus"
msgstr "Показывать «Создать ссылку» в контекстных меню"

#: data/io.github.sachesi.spiral.gschema.xml:58
msgid "Show “Open in New Tab” in context menus"
msgstr "Показывать «Открыть в новой вкладке» в контекстных меню"

#: data/io.github.sachesi.spiral.gschema.xml:62
msgid "Show “Open in New Window” in context menus"
msgstr "Показывать «Открыть в новом окне» в контекстных меню"

#: data/io.github.sachesi.spiral.gschema.xml:66
msgid "Show “Copy to…” in context menus"
msgstr "Показывать «Копировать в…» в контекстных меню"

#: data/io.github.sachesi.spiral.gschema.xml:70
msgid "Show “Move to…” in context menus"
msgstr "Показывать «Переместить в…» в контекстных меню"

#: data/io.github.sachesi.spiral.gschema.xml:74
msgid "Offer locations on other machines"
msgstr "Предлагать расположения на других машинах"

#: data/io.github.sachesi.spiral.gschema.xml:75
msgid ""
"Connecting to a server, the network in the sidebar, and shares opened by "
"address. Nothing of it works without gvfs."
msgstr "Подключение к серверу, сеть в боковой панели и общие ресурсы, открытые по адресу. Ничего из этого не работает без gvfs."

#: data/io.github.sachesi.spiral.gschema.xml:79
msgid "Servers connected to before, the most recent first"
msgstr "Серверы, к которым уже подключались, начиная с последнего"

#: data/io.github.sachesi.spiral.gschema.xml:80
msgid ""
"Offered again by the Connect to Server dialog. Ten at most; the oldest goes "
"when an eleventh is added."
msgstr ""
"Предлагаются снова в диалоге подключения к серверу. Не больше десяти: при "
"добавлении одиннадцатого самый старый удаляется."

#: data/io.github.sachesi.spiral.gschema.xml:84
msgid "Expandable folders in list view"
msgstr "Раскрывающиеся папки в виде списка"

#: data/io.github.sachesi.spiral.gschema.xml:88
msgid "Show the root of the filesystem in the sidebar"
msgstr "Показывать корень файловой системы на боковой панели"

#: data/io.github.sachesi.spiral.gschema.xml:92
msgid "Show Favorites in the sidebar"
msgstr "Показывать «Избранное» на боковой панели"

#: data/io.github.sachesi.spiral.gschema.xml:96
msgid "Offer colour tags"
msgstr "Предлагать цветные метки"

#: data/io.github.sachesi.spiral.gschema.xml:97
msgid ""
"Tags are kept on the files themselves, in the user.xdg.tags extended "
"attribute, and listed in the sidebar."
msgstr ""
"Метки хранятся в самих файлах, в расширенном атрибуте user.xdg.tags, и "
"перечислены в боковой панели."

#: data/io.github.sachesi.spiral.gschema.xml:101
msgid "The tags on offer, each a name and a colour"
msgstr "Доступные метки, каждая с именем и цветом"

#: data/io.github.sachesi.spiral.gschema.xml:102
msgid ""
"Seven at most. The colour is one of red, orange, yellow, green, blue, purple "
"and gray, or a #rrggbb of your own. An empty list stands for the seven "
"colours."
msgstr ""
"Не более семи. Цвет — один из red, orange, yellow, green, blue, purple, gray "
"или свой #rrggbb. Пустой список означает семь цветов."

#: data/io.github.sachesi.spiral.gschema.xml:106
msgid "Offer the column view"
msgstr "Предлагать режим просмотра в виде столбцов"

#: data/io.github.sachesi.spiral.gschema.xml:107
msgid ""
"Adds the columns to the views the view button and the menu switch between."
msgstr ""
"Добавляет столбцы к режимам просмотра, между которыми переключают кнопка "
"просмотра и меню."

#: data/io.github.sachesi.spiral.gschema.xml:111
msgid "Remember the view mode of each folder"
msgstr "Запоминать режим просмотра для каждой папки"

#: data/io.github.sachesi.spiral.gschema.xml:115
msgid "Open folders that are mostly images and videos in grid view"
msgstr ""
"Открывать папки, состоящие в основном из изображений и видео, в виде сетки"

#: data/io.github.sachesi.spiral.gschema.xml:119
msgid "Terminal emulator for “Open in Terminal”"
msgstr "Эмулятор терминала для «Открыть в терминале»"

#: data/io.github.sachesi.spiral.gschema.xml:120
msgid "Executable name; empty picks the first installed one."
msgstr "Имя исполняемого файла; пустое значение означает первый установленный."

#: data/io.github.sachesi.spiral.gschema.xml:124
msgid "Which files get thumbnails"
msgstr "Для каких файлов показывать миниатюры"

#: data/io.github.sachesi.spiral.gschema.xml:128
msgid "Where searches look into subfolders"
msgstr "Где искать во вложенных папках"

#: data/io.github.sachesi.spiral.gschema.xml:132
msgid "Which folders get their items counted"
msgstr "Для каких папок подсчитывать число объектов"

#: data/io.github.sachesi.spiral.gschema.xml:136
msgid "Largest picture to make a thumbnail of, in megabytes"
msgstr "Наибольшее изображение, для которого создаётся миниатюра, в мегабайтах"

