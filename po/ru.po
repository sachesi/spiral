msgstr "Окно развёрнуто"

#: data/io.github.sachesi.spiral.gschema.xml:203
msgid "Show places sidebar"
msgstr "Показывать боковую панель"

#: data/io.github.sachesi.spiral.gschema.xml:207
msgid "Ask whether to copy or move dropped files"
msgstr "Спрашивать, копировать или переместить перетащенные файлы"

#: data/io.github.sachesi.spiral.gschema.xml:211
