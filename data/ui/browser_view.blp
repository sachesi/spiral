using Gtk 4.0;
using Adw 1;

template $SpiralBrowserView : Box {
  orientation: vertical;
  hexpand: true;
  vexpand: true;

  Overlay {
    hexpand: true;
    vexpand: true;

    child: Stack stack {
      hexpand: true;
      vexpand: true;
      transition-type: none;

      StackPage {
        name: "grid";
        child: ScrolledWindow {
          hscrollbar-policy: never;
          styles ["spiral-grid-view"]
          child: GridView grid_view {
            enable-rubberband: true;
            max-columns: 20;
            min-columns: 1;
          };
        };
      }

      StackPage {
        name: "list";
        child: ScrolledWindow {
          styles ["spiral-list-view"]
          child: ColumnView column_view {
            enable-rubberband: true;
            reorderable: false;
          };
        };
      }

      StackPage {
        name: "columns";
        child: ScrolledWindow columns_scroll {
          vscrollbar-policy: never;
          styles ["spiral-columns-view"]
          child: Box columns_box {
            orientation: horizontal;

            ScrolledWindow miller_scroll {
              hscrollbar-policy: never;
              styles ["spiral-miller-column", "spiral-miller-current"]
              child: ListView miller_list {
                enable-rubberband: true;
              };
            }
          };
        };
      }

      StackPage {
        name: "empty";
        child: Adw.StatusPage empty_page {
          icon-name: "folder-symbolic";
          title: _("Folder is Empty");
        };
      }

      StackPage {
        name: "error";
        child: Adw.StatusPage error_page {
          icon-name: "dialog-error-symbolic";
          title: _("Could Not Open Folder");
        };
      }
    };

    [overlay]
    Box floating_bar {
      halign: end;
      valign: end;
      margin-top: 4;
      margin-bottom: 4;
      margin-start: 4;
      margin-end: 4;
      visible: false;
      styles ["floating-bar"]

      Adw.Spinner floating_spinner {
        visible: false;
        margin-start: 8;
        width-request: 16;
        height-request: 16;
      }

      Box {
        spacing: 6;
        hexpand: true;
        margin-top: 2;
        margin-bottom: 2;
        margin-start: 8;
        margin-end: 8;

        Label floating_primary {
          ellipsize: middle;
          single-line-mode: true;
        }

        Label floating_details {
          single-line-mode: true;
          styles ["dim-label"]
        }
      }
    }
  }
}

