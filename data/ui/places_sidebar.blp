using Gtk 4.0;

menu row_menu {
  section {
    item {
      label: _("_Open");
      action: "sidebar.open";
    }
    item {
      label: _("Open in New _Tab");
      action: "sidebar.open-new-tab";
      hidden-when: "action-disabled";
    }
  }
  section {
    item {
      label: _("Rena_me…");
      action: "sidebar.rename";
      hidden-when: "action-disabled";
    }
    item {
      label: _("_Remove");
      action: "sidebar.remove";
      hidden-when: "action-disabled";
    }
  }
  section {
    item {
      label: _("_Eject");
      action: "sidebar.eject";
      hidden-when: "action-disabled";
    }
    item {
      label: _("_Disconnect");
      action: "sidebar.disconnect";
      hidden-when: "action-disabled";
    }
    item {
      label: _("_Empty Trash…");
      action: "sidebar.empty-trash";
      hidden-when: "action-disabled";
    }
  }
}

menu tag_menu {
  section {
    item {
      label: _("_Open");
      action: "sidebar.open";
    }
    item {
      label: _("Open in New _Tab");
      action: "sidebar.open-new-tab";
    }
  }
  section {
    // The colours are a row of dots, built in code: a submenu is a menu that cannot
    // be dismissed by a click outside it once it has been opened.
    item {
      custom: "colors";
    }
  }
  section {
    item {
      label: _("Rena_me…");
      action: "sidebar.rename";
    }
    item {
      label: _("_Remove…");
      action: "sidebar.remove";
    }
  }
  section {
    item {
      label: _("New _Tag…");
      action: "sidebar.new-tag";
      hidden-when: "action-disabled";
    }
  }
}

template $SpiralPlacesSidebar : Box {
  orientation: vertical;

  ScrolledWindow {
    hscrollbar-policy: never;
    vexpand: true;
    child: ListBox list {
      selection-mode: single;
      row-activated => $on_row_activated() swapped;
      styles ["navigation-sidebar"]
    };
  }
}
