using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("New Window");
      accelerator: "<Control>n";
    }

    Adw.ShortcutsItem {
      title: _("New Tab");
      accelerator: "<Control>t";
    }

    Adw.ShortcutsItem {
      title: _("Close Tab");
      accelerator: "<Control>w";
    }

    Adw.ShortcutsItem {
      title: _("Restore Closed Tab");
      accelerator: "<Control><Shift>t";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      accelerator: "<Control><Shift>w";
    }

    Adw.ShortcutsItem {
      title: _("Show All Tabs");
      accelerator: "<Control><Shift>o";
    }

    Adw.ShortcutsItem {
      title: _("Switch to a Tab");
      subtitle: _("Alt and the number of the tab");
      accelerator: "<Alt>1";
    }

    Adw.ShortcutsItem {
      title: _("Preferences");
      accelerator: "<Control>comma";
    }

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      accelerator: "<Control>question";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      accelerator: "<Control>q";
    }
  }

  Adw.ShortcutsSection {
    title: _("Navigation");

    Adw.ShortcutsItem {
      title: _("Back");
      accelerator: "<Alt>Left";
    }

    Adw.ShortcutsItem {
      title: _("Forward");
      accelerator: "<Alt>Right";
    }

    Adw.ShortcutsItem {
      title: _("Parent Folder");
      accelerator: "<Alt>Up BackSpace";
    }

    Adw.ShortcutsItem {
      title: _("Home Folder");
      accelerator: "<Alt>Home";
    }

    Adw.ShortcutsItem {
      title: _("Edit Location");
      accelerator: "<Control>l";
    }

    Adw.ShortcutsItem {
      title: _("Folder Menu");
      accelerator: "F10";
    }

    Adw.ShortcutsItem {
      title: _("Search Current Folder");
      accelerator: "<Control>f";
    }

    Adw.ShortcutsItem {
      title: _("Reload");
      accelerator: "F5 <Control>r";
    }

    Adw.ShortcutsItem {
      title: _("Stop Loading or End Search");
      accelerator: "Escape";
    }

    Adw.ShortcutsItem {
      title: _("Add Bookmark");
      accelerator: "<Control>d";
    }
  }

  Adw.ShortcutsSection {
    title: _("View");

    Adw.ShortcutsItem {
      title: _("Grid View");
      accelerator: "<Control>1";
    }

    Adw.ShortcutsItem {
      title: _("List View");
      accelerator: "<Control>2";
    }

    Adw.ShortcutsItem {
      title: _("Column View");
      accelerator: "<Control>3";
    }

    Adw.ShortcutsItem {
      title: _("Zoom In");
      accelerator: "<Control>plus";
    }

    Adw.ShortcutsItem {
      title: _("Zoom Out");
      accelerator: "<Control>minus";
    }

    Adw.ShortcutsItem {
      title: _("Normal Size");
      accelerator: "<Control>0";
    }

    Adw.ShortcutsItem {
      title: _("Show Hidden Files");
      accelerator: "<Control>h";
    }

    Adw.ShortcutsItem {
      title: _("Show Sidebar");
      accelerator: "F9";
    }

    Adw.ShortcutsItem {
      title: _("Split View");
      accelerator: "F3";
    }

    Adw.ShortcutsItem {
      title: _("Switch Pane");
      accelerator: "F6";
    }
  }

  Adw.ShortcutsSection {
    title: _("Files");

    Adw.ShortcutsItem {
      title: _("Select All");
      accelerator: "<Control>a";
    }

    Adw.ShortcutsItem {
      title: _("Select Items Matching");
      accelerator: "<Control>s";
    }

    Adw.ShortcutsItem {
      title: _("Invert Selection");
      accelerator: "<Control><Shift>i";
    }

    Adw.ShortcutsItem {
      title: _("Cut");
      accelerator: "<Control>x";
    }

    Adw.ShortcutsItem {
      title: _("Copy");
      accelerator: "<Control>c";
    }

    Adw.ShortcutsItem {
      title: _("Paste");
      accelerator: "<Control>v";
    }

    Adw.ShortcutsItem {
      title: _("Rename");
      accelerator: "F2";
    }

    Adw.ShortcutsItem {
      title: _("New Folder");
      accelerator: "<Control><Shift>n";
    }

    Adw.ShortcutsItem {
      title: _("Move to Trash");
      accelerator: "Delete";
    }

    Adw.ShortcutsItem {
      title: _("Delete Permanently");
      accelerator: "<Shift>Delete";
    }

    Adw.ShortcutsItem {
      title: _("Preview");
      accelerator: "space";
    }

    Adw.ShortcutsItem {
      title: _("Open");
      accelerator: "<Control>o";
    }

    Adw.ShortcutsItem {
      title: _("Open in New Tab");
      accelerator: "<Control>Return";
    }

    Adw.ShortcutsItem {
      title: _("Open in New Window");
      accelerator: "<Shift>Return";
    }

    Adw.ShortcutsItem {
      title: _("Open Item Location");
      accelerator: "<Control><Alt>o";
    }

    Adw.ShortcutsItem {
      title: _("Create Link");
      accelerator: "<Control>m";
    }

    Adw.ShortcutsItem {
      title: _("Properties");
      accelerator: "<Alt>Return <Control>i";
    }

    Adw.ShortcutsItem {
      title: _("Context Menu");
      accelerator: "Menu <Shift>F10";
    }

    Adw.ShortcutsItem {
      title: _("Undo");
      accelerator: "<Control>z";
    }

    Adw.ShortcutsItem {
      title: _("Redo");
      accelerator: "<Control><Shift>z";
    }
  }
}
